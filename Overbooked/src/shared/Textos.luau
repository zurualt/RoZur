	["¡Te has facturado a ti mismo! Recógete en la cinta de equipajes"] = { en = "You checked yourself in! Pick yourself up at the baggage carousel", pt = "Você despachou a si mesmo! Retire-se na esteira de bagagens", fr = "Tu t'es enregistré toi-même ! Récupère-toi au tapis à bagages" },
	["Último aviso para el dueño del cocodrilo: su equipaje le está buscando."] = { en = "Final call for the crocodile's owner: your luggage is looking for you.", pt = "Última chamada para o dono do crocodilo: sua bagagem está procurando você.", fr = "Dernier appel pour le propriétaire du crocodile : vos bagages vous cherchent." },
	["El vuelo a ninguna parte sale puntual. Es broma, nunca sale puntual."] = { en = "The flight to nowhere is on time. Just kidding, it's never on time.", pt = "O voo para lugar nenhum está no horário. Brincadeira, nunca está.", fr = "Le vol pour nulle part est à l'heure. Je plaisante, il ne l'est jamais." },
	["Se ruega a los pilotos que dejen de pulsar todos los botones a la vez."] = { en = "Pilots are kindly asked to stop pressing all the buttons at once.", pt = "Pede-se aos pilotos que parem de apertar todos os botões ao mesmo tempo.", fr = "Les pilotes sont priés d'arrêter d'appuyer sur tous les boutons en même temps." },
	["Recuerde: el chaleco salvavidas está debajo de su asiento. Probablemente."] = { en = "Remember: your life jacket is under your seat. Probably.", pt = "Lembre-se: o colete salva-vidas está debaixo do seu assento. Provavelmente.", fr = "Rappel : votre gilet de sauvetage est sous votre siège. Probablement." },
	["Objeto perdido en la cinta de equipajes: un pollo de goma. Pregunte en información."] = { en = "Lost item on the baggage carousel: one rubber chicken. Ask at the information desk.", pt = "Objeto perdido na esteira de bagagens: um frango de borracha. Pergunte nas informações.", fr = "Objet trouvé sur le tapis à bagages : un poulet en caoutchouc. Demandez à l'accueil." },
	["Su puerta de embarque es la del círculo de colores. No, esa no. La otra."] = { en = "Your boarding gate is the colored circle. No, not that one. The other one.", pt = "Seu portão de embarque é o do círculo colorido. Não, esse não. O outro.", fr = "Votre porte d'embarquement, c'est le cercle de couleur. Non, pas celui-là. L'autre." },
	["Por su seguridad, no se suban a la cinta de equipajes. Bueno, solo un ratito."] = { en = "For your safety, do not ride the baggage carousel. Well, just for a bit.", pt = "Para sua segurança, não subam na esteira de bagagens. Bom, só um pouquinho.", fr = "Pour votre sécurité, ne montez pas sur le tapis à bagages. Bon, juste un petit peu." },
	["¡PIIIP! ¿Eso es una llave inglesa en el bolsillo?"] = { en = "BEEEEP! Is that a wrench in your pocket?", pt = "PIIIII! Isso é uma chave inglesa no seu bolso?", fr = "BIIIP ! C'est une clé à molette dans ta poche ?" },
	["¡PIIIP! Detectado: un pollo de goma sospechoso."] = { en = "BEEEEP! Detected: one suspicious rubber chicken.", pt = "PIIIII! Detectado: um frango de borracha suspeito.", fr = "BIIIP ! Détecté : un poulet en caoutchouc suspect." },
	["¡PIIIP! Demasiadas monedas. O demasiado metal en los dientes."] = { en = "BEEEEP! Too many coins. Or too much metal in your teeth.", pt = "PIIIII! Moedas demais. Ou metal demais nos dentes.", fr = "BIIIP ! Trop de pièces. Ou trop de métal dans les dents." },
	["¡PIIIP! Falsa alarma. Creo."] = { en = "BEEEEP! False alarm. I think.", pt = "PIIIII! Alarme falso. Acho.", fr = "BIIIP ! Fausse alerte. Je crois." },
	["¡PIIIP! Pase, pase. Pero no vuelva a pitar."] = { en = "BEEEEP! Go on through. But don't beep again.", pt = "PIIIII! Pode passar. Mas não apite de novo.", fr = "BIIIP ! Passez, passez. Mais ne sonnez plus." },
