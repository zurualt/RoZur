	["¡Se ha escapado una cabra de la bodega! Cógela y lánzala de vuelta a la bodega"] = { en = "A goat escaped from the hold! Grab it and throw it back in the hold", pt = "Uma cabra fugiu do porão! Pegue-a e jogue de volta no porão", fr = "Une chèvre s'est échappée de la soute ! Attrape-la et renvoie-la en soute" },
	["¡Gallinas sueltas por la cabina! Atrápalas y devuélvelas a la bodega"] = { en = "Chickens loose in the cabin! Catch them and put them back in the hold", pt = "Galinhas soltas na cabine! Pegue-as e devolva ao porão", fr = "Des poules en liberté en cabine ! Attrape-les et remets-les en soute" },
	["¡Un bebé llora sin parar! Coge el biberón de la cocina y dáselo a su familia"] = { en = "A baby won't stop crying! Grab the bottle from the galley and give it to the family", pt = "Um bebê não para de chorar! Pegue a mamadeira na cozinha e entregue à família", fr = "Un bébé pleure sans arrêt ! Prends le biberon en cuisine et donne-le à sa famille" },
	["¡Bebé dormido! Toda la fila os lo agradece +50"] = { en = "Baby asleep! The whole row thanks you +50", pt = "Bebê dormindo! A fileira inteira agradece +50", fr = "Bébé endormi ! Toute la rangée vous remercie +50" },
	["El bebé se ha dormido de tanto llorar"] = { en = "The baby cried itself to sleep", pt = "O bebê dormiu de tanto chorar", fr = "Le bébé s'est endormi à force de pleurer" },
	["¡Te ha estornudado encima!"] = { en = "Someone sneezed all over you!", pt = "Espirraram em você!", fr = "On t'a éternué dessus !" },
	["¡Un pasajero tiene alergia! Dale agua antes de que vuelva a estornudar"] = { en = "A passenger has allergies! Give them water before they sneeze again", pt = "Um passageiro tem alergia! Dê água antes que espirre de novo", fr = "Un passager est allergique ! Donne-lui de l'eau avant qu'il éternue encore" },
	["¡Alergia curada con un vaso de agua! +30"] = { en = "Allergy cured with a glass of water! +30", pt = "Alergia curada com um copo de água! +30", fr = "Allergie soignée avec un verre d'eau ! +30" },
	["Al pasajero se le ha pasado la alergia (y a todos los demás, la paciencia)"] = { en = "The passenger's allergy is gone (and so is everyone's patience)", pt = "A alergia do passageiro passou (e a paciência de todos também)", fr = "L'allergie du passager est passée (et la patience de tout le monde aussi)" },
