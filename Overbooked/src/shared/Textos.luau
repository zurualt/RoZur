	["¡Avalancha de equipaje! ¡Cuidado con la cabeza!"] = { en = "Luggage avalanche! Mind your heads!", pt = "Avalanche de bagagem! Cuidado com a cabeça!", fr = "Avalanche de bagages ! Attention à vos têtes !" },
