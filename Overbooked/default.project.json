{
  "name": "Overbooked",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotos": {
        "$className": "Folder",
        "Piloto": { "$className": "UnreliableRemoteEvent" },
        "Agarrar": { "$className": "RemoteEvent" },
        "Soltar": { "$className": "RemoteEvent" },
        "Usar": { "$className": "RemoteEvent" },
        "Sostener": { "$className": "RemoteEvent" },
        "Ragdoll": { "$className": "RemoteEvent" },
        "Aviso": { "$className": "RemoteEvent" },
        "Sacudida": { "$className": "UnreliableRemoteEvent" },
        "Sonido": { "$className": "UnreliableRemoteEvent" },
        "Tienda": { "$className": "RemoteEvent" },
        "Resultados": { "$className": "RemoteEvent" },
        "Disparar": { "$className": "RemoteEvent" },
        "Efecto": { "$className": "UnreliableRemoteEvent" }
      },
      "Estado": {
        "$className": "Folder"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false,
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "CharacterWalkSpeed": 16,
        "CharacterJumpPower": 45,
        "CharacterUseJumpPower": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -400
      },
      "Avion": {
        "$path": "mapa/Avion.model.json"
      },
      "Aeropuerto": {
        "$path": "mapa/Aeropuerto.model.json"
      }
    },
    "ServerStorage": {
      "Isla": {
        "$path": "mapa/Isla.model.json"
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.26, 0.25, 0.27],
        "OutdoorAmbient": [0.44, 0.44, 0.48],
        "Brightness": 1.6,
        "ExposureCompensation": -0.25,
        "ClockTime": 14.2,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.25
      },
      "Atmosfera": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.12,
          "Color": [0.78, 0.86, 0.95],
          "Decay": [0.55, 0.68, 0.85],
          "Glare": 0.08,
          "Haze": 0.7
        }
      },
      "Brillo": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.18,
          "Size": 24,
          "Threshold": 1.8
        }
      },
      "Color": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": -0.05,
          "Contrast": 0.08,
          "Brightness": 0,
          "TintColor": [1, 0.96, 0.9]
        }
      },
      "ColorGrading": {
        "$className": "ColorGradingEffect",
        "$properties": {
          "TonemapperPreset": "Default"
        }
      }
    },
    "VoiceChatService": {
      "$properties": {
        "EnableDefaultVoice": true,
        "UseAudioApi": "Enabled"
      }
    }
  }
}
