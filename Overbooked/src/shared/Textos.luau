	["¡Un pasajero se ha quedado encerrado en el baño! Tirad de la puerta"] = { en = "A passenger is stuck in the toilet! Yank the door open", pt = "Um passageiro ficou preso no banheiro! Puxem a porta", fr = "Un passager est coincé aux toilettes ! Tirez sur la porte" },
	["¡{1} ha rescatado al pasajero del baño! +40"] = { en = "{1} rescued the passenger from the toilet! +40", pt = "{1} resgatou o passageiro do banheiro! +40", fr = "{1} a sauvé le passager des toilettes ! +40" },
	["El pasajero del baño ha salido solo... y muy enfadado"] = { en = "The toilet passenger got out alone... and is furious", pt = "O passageiro do banheiro saiu sozinho... e muito bravo", fr = "Le passager des toilettes est sorti seul... et il est furieux" },
	["¡La cafetera se ha vuelto loca! Dale con la llave inglesa (F) antes de que explote"] = { en = "The coffee machine went haywire! Whack it with the wrench (F) before it explodes", pt = "A cafeteira enlouqueceu! Bata nela com a chave inglesa (F) antes que exploda", fr = "La machine à café est devenue folle ! Tape-la avec la clé (F) avant qu'elle explose" },
	["¡Cafetera arreglada a llavazos! +40"] = { en = "Coffee machine fixed with a wrench! +40", pt = "Cafeteira consertada na base da chave! +40", fr = "Machine à café réparée à coups de clé ! +40" },
	["¡La cafetera ha explotado! -40"] = { en = "The coffee machine exploded! -40", pt = "A cafeteira explodiu! -40", fr = "La machine à café a explosé ! -40" },
	["¡Placaje de {1}! La salida de emergencia sigue cerrada +60"] = { en = "Tackle by {1}! The emergency exit stays shut +60", pt = "Placagem de {1}! A saída de emergência continua fechada +60", fr = "Plaquage de {1} ! L'issue de secours reste fermée +60" },
	["¡Un pasajero quiere abrir la salida de emergencia! ¡Placadle antes de que llegue!"] = { en = "A passenger wants to open the emergency exit! Tackle them before they get there!", pt = "Um passageiro quer abrir a saída de emergência! Derrubem-no antes que chegue!", fr = "Un passager veut ouvrir l'issue de secours ! Plaquez-le avant qu'il y arrive !" },
	["¡Ha abierto la salida de emergencia! Cerrad la puerta (E) antes de que salga todo volando -80"] = { en = "They opened the emergency exit! Close the door (E) before everything flies out -80", pt = "Abriram a saída de emergência! Fechem a porta (E) antes que tudo saia voando -80", fr = "Il a ouvert l'issue de secours ! Fermez la porte (E) avant que tout s'envole -80" },
	["¡Salida de emergencia cerrada!"] = { en = "Emergency exit closed!", pt = "Saída de emergência fechada!", fr = "Issue de secours fermée !" },
	["¡Alguien ha calentado pescado en el microondas! Dispersa la peste con el extintor"] = { en = "Someone microwaved fish! Blow the stink away with the extinguisher", pt = "Alguém esquentou peixe no micro-ondas! Espalhe o fedor com o extintor", fr = "Quelqu'un a réchauffé du poisson au micro-ondes ! Chasse la puanteur avec l'extincteur" },
	["¡Peste dispersada! +35"] = { en = "Stink cleared! +35", pt = "Fedor dissipado! +35", fr = "Puanteur dissipée ! +35" },
	["La peste se ha ido sola (por fin)"] = { en = "The stink went away on its own (finally)", pt = "O fedor sumiu sozinho (finalmente)", fr = "La puanteur est partie toute seule (enfin)" },
	["¡Turbulencia disco! Que nadie deje de bailar"] = { en = "Disco turbulence! Nobody stop dancing", pt = "Turbulência disco! Ninguém para de dançar", fr = "Turbulences disco ! Que personne n'arrête de danser" },
	["¡El piloto automático se ha bebido el champán de primera! Desconéctalo 3 veces desde la cabina"] = { en = "The autopilot drank the first-class champagne! Switch it off 3 times from the cockpit", pt = "O piloto automático bebeu o champanhe da primeira classe! Desligue-o 3 vezes na cabine", fr = "Le pilote automatique a bu le champagne de première ! Coupe-le 3 fois depuis le cockpit" },
	["¡Piloto automático sobrio! Se ha ido a dormir la mona +45"] = { en = "Autopilot sober! It went to sleep it off +45", pt = "Piloto automático sóbrio! Foi curar a ressaca +45", fr = "Pilote automatique dessoûlé ! Il est allé cuver +45" },
	["¡Desconectado! ({1}/3)... pero sigue con hipo"] = { en = "Switched off! ({1}/3)... but it still has hiccups", pt = "Desligado! ({1}/3)... mas continua com soluço", fr = "Coupé ! ({1}/3)... mais il a toujours le hoquet" },
	["¡El piloto automático se ha vuelto a conectar solo!"] = { en = "The autopilot switched itself back on!", pt = "O piloto automático se religou sozinho!", fr = "Le pilote automatique s'est rallumé tout seul !" },
	["El piloto automático se ha quedado dormido... y sobrio"] = { en = "The autopilot fell asleep... and sobered up", pt = "O piloto automático dormiu... e ficou sóbrio", fr = "Le pilote automatique s'est endormi... et a dessoûlé" },
	["¡El carrito de comida se ha desbocado! Cógelo para pararlo"] = { en = "The food trolley is out of control! Grab it to stop it", pt = "O carrinho de comida disparou! Pegue-o para pará-lo", fr = "Le chariot repas s'est emballé ! Attrape-le pour l'arrêter" },
	["¡{1} ha frenado el carrito desbocado! +25"] = { en = "{1} stopped the runaway trolley! +25", pt = "{1} parou o carrinho desgovernado! +25", fr = "{1} a arrêté le chariot fou ! +25" },
